# =============================================================================
# Web Kyrgyzstan — шаблон переменных окружения
#
#   cp .env.example .env    и заполнить значения с пометкой [МЕНЯТЬ]
#
# Файл .env в Git не попадает. Настоящие пароли и ключи храните только в нём.
# =============================================================================

# Имя проекта для Docker Compose: префикс контейнеров, volume и сети.
# Должно быть уникальным среди проектов на одной машине.
COMPOSE_PROJECT_NAME=webkg

# Порты на хосте (127.0.0.1). Не должны совпадать с другими проектами.
WEB_PORT=8098
DB_PORT=5446

# -----------------------------------------------------------------------------
# DJANGO
# -----------------------------------------------------------------------------
# [МЕНЯТЬ] Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Домены через запятую, без схемы
ALLOWED_HOSTS=localhost,127.0.0.1
# Те же домены со схемой (для production: https://webkg.zeastudio.su)
CSRF_TRUSTED_ORIGINS=http://localhost:8098,http://127.0.0.1:8098

# [МЕНЯТЬ в production] Адрес админки без слешей, например: kg-panel-7f3a
ADMIN_URL=admin

TIME_ZONE=Asia/Bishkek

# Количество воркеров Gunicorn (production): обычно 2 × ядра + 1
GUNICORN_WORKERS=3

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_DB=webkg
POSTGRES_USER=webkg
# [МЕНЯТЬ] Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

# Имя сервиса в docker-compose и внутренний порт — не менять
POSTGRES_HOST=db
POSTGRES_PORT=5432
